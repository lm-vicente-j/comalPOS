DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comal_pos"
# Used only by the Prisma CLI (migrate / db push). Falls back to DATABASE_URL
# when unset. On Vercel/Supabase this must be a session or direct URL, not
# the transaction pooler. See docs/database.md.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/comal_pos"
AUTH_SECRET="generate-a-unique-secret-with-npx-auth-secret"

# --- Test suites (see docs/testing.md) ---
# The suites delete every domain row in these databases: never point them at the
# development database. Names must end in _test (integration) / _test_e2e (browser).
# `npm run test:setup` offers to create them, and asks before resetting existing ones.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comalpos_test"
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comalpos_test_e2e"
# Directory with the PostgreSQL client binaries (psql) used by `npm run test:setup`,
# for example /usr/bin or /usr/lib/postgresql/16/bin. Falls back to psql on PATH.
LOCAL_POSTGRES="/usr/bin"
