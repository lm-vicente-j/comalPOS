DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comal_pos"
# Used only by the Prisma CLI (migrate / db push). Falls back to DATABASE_URL
# when unset. On Vercel/Supabase this must be a session or direct URL, not
# the transaction pooler. See docs/database.md.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/comal_pos"
AUTH_SECRET="generate-a-unique-secret-with-npx-auth-secret"
